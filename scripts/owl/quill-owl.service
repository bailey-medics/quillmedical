# Owl, the alert watcher, as a systemd user service on the home box.
#
# Installed by `just owl-install` from quillmedical-owl, Owl's worktree, which links
# this file into ~/.config/systemd/user/. Read its log with
# `journalctl --user -u quill-owl`. It logs fingerprints and
# outcomes, never the alert text.
#
# A user service, so it runs as the watcher's own user and reads only that
# user's files: the env file below is ~/.config/quill-owl/env,
# mode 0600, holding SLACK_APP_TOKEN, SLACK_BOT_TOKEN and
# OWL_CHANNEL. `loginctl enable-linger` lets it start at boot
# with nobody logged in.
#
# The plan named `After=docker.service` too. A user service cannot be
# ordered against a system one, which its manager does not see, and the
# daemon needs no Docker of its own: only the tests the /alert skill runs
# do, and they start when an alert arrives, long after boot.

[Unit]
Description=Owl, the Quill alert watcher: types App production alerts into quillmedical-owl
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/.config/quill-owl/env

[Service]
Type=simple
EnvironmentFile=%h/.config/quill-owl/env
WorkingDirectory=%h/github/quillmedical-owl/scripts/owl
ExecStartPre=%h/github/quillmedical-owl/scripts/owl/start-session.sh
ExecStart=/usr/bin/env node src/main.ts
Restart=always
RestartSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
