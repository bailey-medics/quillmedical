{#-
  Password reset. Context:
    reset_url    the link that resets the password
    ttl_minutes  how long the link lasts
    name         who to greet: their full name, or their username where
                 the account has none
    username     the account's username, which they log in with
    email        the address this is sent to, said back to them: many
                 people read several addresses in one mailbox
-#}
{% extends "base.html.j2" %}
{% import "_components.html.j2" as c with context %}

{% block subject %}Reset your Quill password{% endblock subject %}
{% block preheader %}The link lasts {{ ttl_minutes }} minutes.{% endblock preheader %}

{% block body %}
{{ c.heading("Reset your *password*") }}
{{ c.paragraph("Hi " ~ name ~ ",") }}
{{ c.paragraph("You requested a password reset for your Quill account.") }}
{% call c.paragraph() %}Your username is <strong>{{ username }}</strong>. You will need it to log in.{% endcall %}
{{ c.button("Reset your password", reset_url) }}
{{ c.small("This link expires in " ~ ttl_minutes ~ " minutes.") }}
{{ c.small("This email was sent to " ~ email ~ ".") }}
{{ c.small("If you did not ask for this, you can ignore this email. Your password will not change.") }}
{% endblock body %}
#
{% block reason %}You are receiving this because a password reset was requested for this address on Quill.{% endblock reason %}

{% block text %}
Hi {{ name }},

You requested a password reset for your Quill account.

Your username is {{ username }}. You will need it to log in.

Reset your password: {{ reset_url }}

This link expires in {{ ttl_minutes }} minutes.

This email was sent to {{ email }}.

If you did not ask for this, you can ignore this email. Your password will not change.
{% endblock text %}
