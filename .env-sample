POSTGRES_DB=quill
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=quill

EHRBASE_USER=ehrbase_user
EHRBASE_PASSWORD=CHANGE_ME
EHRBASE_ADMIN_USER=ehrbase_admin
EHRBASE_ADMIN_PASSWORD=CHANGE_ME

# Storybook interaction tests: cap parallel headless browsers.
# 8 physical cores here, and each worker drives a full Chromium, so half
# the machine stays free for Docker and other worktrees. Remove this line
# to let jest choose (cores - 1), which oversubscribes a busy machine.
SB_MAX_WORKERS=CHANGE_ME
