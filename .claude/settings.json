{
  "permissions": {
    "allow": [
      "Bash(poetry run *)",
      "Bash(poetry env *)",
      "Bash(git worktree *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git rev-list *)",
      "Bash(python3 -)",
      "Bash(python3 -c ' *)",
      "Bash(grep -vE \"Skipped$|no files to check\")",
      "Bash(grep -v \"^--$\")",
      "Bash(grep -v \"^\\\\s*$\")",
      "Bash(shellcheck *)",
      "Bash(bats *)",
      "Bash(npx --no-install markdownlint-cli2 *)",
      "Read(//Users/markbailey/github/**)",
      "Read(//home/markbailey/github/**)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(just --list)",
      "Bash(just stack-log)",
      "Bash(just stl)",
      "Bash(just stack-log-long)",
      "Bash(just stack-files)",
      "Bash(just stack-files *)",
      "Bash(just ub *)",
      "Bash(just uf *)",
      "Bash(just email-preview *)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/notification.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/alert-watcher-busy.sh clear",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/notification.sh needs-input",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/notification.sh needs-input",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/alert-watcher-busy.sh set",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
