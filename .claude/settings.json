{
  "permissions": {
    "allow": [
      "Bash(poetry run *)",
      "Bash(poetry env *)",
      "Bash(git worktree *)",
      "Bash(python3 -)",
      "Bash(grep -vE \"Skipped$|no files to check\")",
      "Bash(grep -n \"queue without limit\\\\|contents: write\\\\`\\\\b\\\\|newest_recorded_commit\\\\|compare-API\\\\|skip.*straggler\" docs/docs/plans/2026-08-29-gate-notification-workflow-plan.md)",
      "Bash(shellcheck --source-path=SCRIPTDIR .github/scripts/ci/wait-for-ancestor-decisions.sh)",
      "Bash(bats .github/scripts/ci/wait-for-ancestor-decisions.bats)",
      "Bash(python3 -c ' *)",
      "Bash(cd /Users/markbailey/github/quillmedical-3/frontend/src && cat components/layouts/layoutConstants.ts | grep -v \"^ \\\\*\\\\|^/\\\\*\"; grep -rn \"ActionIcon\" ../eslint.config.js | head -5; grep -rln \"EllipsisMenu\" . | grep -v -E \"stories|test|ellipsis-menu\" | wc -l; grep -rln \"FilterSelect\\\\b\" . | grep -v -E \"stories|test|form/FilterSelect\" | wc -l)",
      "Read(//Users/markbailey/github/**)",
      "Bash(npx --no-install markdownlint-cli2 docs/docs/plans/2026-09-28-touch-target-sizes-plan.md)",
      "Bash(git rev-list *)",
      "Bash(sed -i '' 's/classes\\\\.item}/classes.touchItem}/' EllipsisMenu.tsx)",
      "Bash(sed -i '' 's/^  \\\\.item {/  .touchItem {/' EllipsisMenu.module.css)",
      "Bash(sed -i '' 's#\\).toMatch\\(/item/\\);#\\).toMatch\\(/touchItem/\\);#' EllipsisMenu.test.tsx)",
      "Bash(grep -v \"^--$\")"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/notification.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/notification.sh needs-input",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/notification.sh needs-input",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
