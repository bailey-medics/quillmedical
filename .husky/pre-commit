#!/usr/bin/env sh

# The hook lives in .githooks/pre-commit. Git only reaches this file when
# core.hooksPath still says .husky, so it says how to repoint, then runs
# the real hook. Delete this folder once it points at .githooks on every
# machine.

echo "core.hooksPath still points at .husky. Repoint it with:" >&2
echo "  git config core.hooksPath .githooks" >&2

exec "$(dirname "$0")/../.githooks/pre-commit" "$@"
