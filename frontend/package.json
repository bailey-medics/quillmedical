{
  "name": "frontend",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "public_pages"
  ],
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "generate:types": "tsx scripts/generate-json-from-yaml.ts",
    "dev": "yarn generate:types && vite",
    "build": "yarn generate:types && tsc -b && vite build",
    "storybook": "yarn generate:types && storybook dev -p 6006",
    "storybook:build": "yarn generate:types && storybook build -o ../docs/docs/code/storybook",
    "storybook:test": "test-storybook --testTimeout 60000 ${SB_SHARD:+--shard=$SB_SHARD}",
    "storybook:test:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"yarn storybook --no-open --quiet --ci\" \"wait-on http-get://127.0.0.1:6006/index.json -t 120000 && yarn storybook:test\"",
    "docs:build": "typedoc",
    "lint-staged": "lint-staged",
    "eslint": "yarn generate:types && eslint \"{src,e2e,scripts,.storybook,public_pages}/**/*.{ts,tsx}\" \"*.ts\" --max-warnings=0 --cache --cache-location .eslintcache",
    "prettier": "prettier --check \"{src,e2e,scripts,.storybook,public,public_pages}/**/*.{js,jsx,ts,tsx,css,scss,md,json,mdx,html}\" \"*.{js,ts,json,md,html}\" --ignore-unknown",
    "prettier:fix": "prettier --write \"{src,e2e,scripts,.storybook,public,public_pages}/**/*.{js,jsx,ts,tsx,css,scss,md,json,mdx,html}\" \"*.{js,ts,json,md,html}\" --ignore-unknown",
    "stylelint": "stylelint \"{src,public,public_pages,.storybook}/**/*.{scss,css}\"",
    "typecheck:all": "yarn generate:types && tsc --project tsconfig.check.json --noEmit && tsc --project tsconfig.node.json --noEmit && tsc --project public_pages/tsconfig.json --noEmit && tsc --project ../tools/review-marks/tsconfig.json",
    "unit-test:run": "yarn generate:types && vitest --environment jsdom --run --watch=false"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.2.6",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@mantine/core": "^9.7.2",
    "@mantine/dates": "^9.7.2",
    "@mantine/dropzone": "9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@tabler/icons-react": "^3.49.0",
    "@videojs/react": "10.0.1",
    "@videojs/youtube-video": "10.0.1",
    "axios": "^1.12.2",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "js-cookie": "^3.0.5",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.90.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@storybook/test-runner": "0.26.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.5.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/vscode": "1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "concurrently": "^10.0.6",
    "cspell": "^10.3.6",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^2.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-regexp": "^3.0.0",
    "eslint-plugin-storybook": "10.6.1",
    "husky": "9.1.7",
    "jiti": "^2",
    "js-yaml": "^5.4.3",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-scss": "^4.0.9",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "remark-gfm": "^4.0.1",
    "sass": "^1.105.1",
    "storybook": "10.6.2",
    "storybook-addon-pseudo-states": "10.6.1",
    "stylelint": "^17.16.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "ts-api-utils": "^2.4.0",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.13",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{md,mdx,json,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
