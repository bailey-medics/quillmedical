{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.check.tsbuildinfo",
    "types": [
      "react",
      "react-dom",
      "vitest/globals",
      "@testing-library/jest-dom",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "scripts/list-public-guides.ts",
    "e2e",
    "playwright.config.ts",
    "playwright.guides.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "public_pages"]
}
