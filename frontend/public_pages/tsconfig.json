{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["../src/*"],
      "@components/*": ["../src/components/*"],
      "@design/*": ["../src/design/*"],
      "@domains/*": ["../src/domains/*"]
    }
  },
  "include": ["src", "../src", "scripts", "vite.config.ts"],
  "exclude": ["../src/**/*.stories.*"]
}
