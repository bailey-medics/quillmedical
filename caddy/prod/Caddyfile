# Production Caddyfile — served inside the frontend prod container
# Caddy listens on :8080 (unprivileged); the GCP Global HTTPS Load Balancer handles:
#   - TLS termination (Google-managed certificate)
#   - Path routing: /api/* → backend Cloud Run, /* → this container
#   - Cloud Armor WAF + rate limiting
#   - HTTP → HTTPS redirect
#
# Port 8080 is used because Cloud Run strips Linux file capabilities
# (cap_net_bind_service), preventing non-root users from binding to :80.

{
	admin off
}

:8080 {
	encode zstd gzip

	# ──────────────────────────────────────────────
	# Security headers (applied to all responses)
	# ──────────────────────────────────────────────
	header {
		# HSTS — tell browsers to always use HTTPS (2 years).
		# No `preload` token: it does nothing unless the domain is submitted
		# at hstspreload.org, which it never has been — checked, and the
		# status comes back "unknown". Claiming it read as a commitment that
		# did not exist, and removal from a list shipped inside browsers
		# takes months, so it should be added only alongside a submission.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# CSP — our own domain, plus GCS for the two things that cannot
		# come from it.
		#
		# `connect-src` carries https://storage.googleapis.com because an
		# admin uploading a lecture sends the bytes straight to the bucket
		# on a signed resumable URL: a POST to open the session, then a PUT
		# of the file to the session URL GCS hands back. Both are XHR, so
		# both are `connect-src`, and with `'self'` alone the browser
		# blocks them before they leave the page — reported to the admin
		# only as "Could not start upload", with the real reason in the
		# console.
		#
		# Routing those bytes through the API instead would keep the
		# policy tighter, but a lecture is hundreds of megabytes and would
		# be paid for twice and held in a Cloud Run request throughout,
		# which is the reason the upload goes direct in the first place.
		#
		# Playback needs nothing here: video is served from /videos/* on
		# this same domain, through the load balancer's backend bucket.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://storage.googleapis.com; font-src 'self'; connect-src 'self' https://storage.googleapis.com; frame-src 'self' https://www.youtube.com; frame-ancestors 'none'"
		# Prevent clickjacking
		X-Frame-Options "DENY"
		# Prevent MIME-type sniffing
		X-Content-Type-Options "nosniff"
		# Control referrer information
		Referrer-Policy "strict-origin-when-cross-origin"
		# Restrict browser features
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Remove server identity
		-Server
	}

	# ──────────────────────────────────────────────
	# Health check (for Cloud Run container probes)
	# ──────────────────────────────────────────────
	handle /healthz {
		respond "ok" 200
	}

	# ──────────────────────────────────────────────
	# PWA manifest
	# ──────────────────────────────────────────────
	@webmanifest path /*.webmanifest
	header @webmanifest Content-Type "application/manifest+json"
	header @webmanifest Cache-Control "no-cache"

	# ──────────────────────────────────────────────
	# SPA — React app at /
	# ──────────────────────────────────────────────
	handle {
		root * /srv/app

		# Static assets with hashed filenames — cache aggressively (1 year)
		@hashed path_regexp \.[-a-zA-Z0-9]{8,}\.(js|css|woff2?|png|jpg|svg|ico)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# HTML and other non-hashed files — always revalidate
		@html path *.html /
		header @html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
