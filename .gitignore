.env
patient_data/
cookies.txt
node_modules/
.DS_Store
certificate-preview.pdf

# Generated HTML files from public_pages templates
frontend/public_pages/*.html

# Generated files - DO NOT COMMIT
# Backend uses YAML directly, only frontend needs generated JSON
# Ignore JSON files but keep type declarations
frontend/src/generated/*.json
!frontend/src/generated/*.d.ts

# Generated JSON from YAML
*.generated.json

prompt-output.md

# Written by the Storybook upgrade tool wherever it is run from.
# frontend/.gitignore covers *.log there; this covers the root.
debug-storybook.log

site/

# Files kept out of git
/local

# Teaching content repos (cloned locally)
teaching-repos/
# Teaching content for the end-to-end tests (.github/scripts/ci/fetch-e2e-teaching.sh)
.e2e-teaching/

.venv
__pycache__/
.mypy_cache/
.ruff_cache/
*.pyc

# Stray Yarn state (no Yarn project at repo root; real project is in frontend/)
/.yarn/

# eslint
.eslintcache
